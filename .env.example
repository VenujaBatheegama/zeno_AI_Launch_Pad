DEMO_USER_ID=00000000-0000-4000-8000-000000000001
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Browser/auth client (anon key + publishable URL)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_STORAGE_BUCKET=cv-sources
GROQ_API_KEY=your-groq-api-key
# Temporary MVP: extra free-tier keys used when the previous key hits rate limits.
GROQ_API_KEY_2=
GROQ_API_KEY_3=
# Or comma-separated: GROQ_API_KEYS=key1,key2,key3
# Prefer gpt-oss for job requirement extraction (strict json_schema).
GROQ_MODEL=openai/gpt-oss-20b
# json_schema-capable fallbacks only. Do not use retired Llama IDs
# (llama-3.3-70b-versatile / llama-3.1-8b-instant shut down 2026-08-16 on free/dev tiers).
GROQ_FALLBACK_MODELS=openai/gpt-oss-120b

# Preferred: OpenWeb Ninja direct JSearch key
# Get it at https://app.openwebninja.com/api/jsearch
JSEARCH_API_KEY=your-openwebninja-jsearch-key
JSEARCH_BASE_URL=https://api.openwebninja.com/jsearch

# Optional RapidAPI alternative (instead of JSEARCH_API_KEY / JSEARCH_BASE_URL):
# RAPIDAPI_KEY=your-rapidapi-key
# JSEARCH_API_HOST=jsearch.p.rapidapi.com

JSEARCH_TIMEOUT_MS=60000
JSEARCH_MAX_REQUESTS=1
JSEARCH_MAX_PAGES=2
JSEARCH_PAGE_SIZE=10

# Hybrid job sources (comma-separated). All enabled sources are equal peers.
# Missing optional credentials disable that source only.
JOB_SOURCES=linkedin,jsearch,theirstack,itpro

# LinkedIn jobs-guest (no API key; HTML cards; may rate-limit)
# LINKEDIN_BASE_URL=https://www.linkedin.com
# LINKEDIN_TIMEOUT_MS=20000
# LINKEDIN_PAGE_SIZE=25
# LINKEDIN_MAX_PAGES=2
# LINKEDIN_MAX_QUERIES=2
# LINKEDIN_ENRICH_DESCRIPTIONS=true
# LINKEDIN_ENRICH_LIMIT=10

# TheirStack (optional contributor; keeps limits small — credits per job returned)
# THEIRSTACK_API_KEY=your-theirstack-api-key
# THEIRSTACK_BASE_URL=https://api.theirstack.com
# THEIRSTACK_TIMEOUT_MS=60000
# THEIRSTACK_POSTED_AT_MAX_AGE_DAYS=30
# THEIRSTACK_PAGE_SIZE=5

# ITPro.lk public jobs API (no key required for GET /api/v1/jobs)
# ITPRO_BASE_URL=https://itpro.lk
# ITPRO_TIMEOUT_MS=20000
# ITPRO_PAGE_SIZE=20

# Next coverage lane (not wired): explicit public ATS boards (Greenhouse/Lever).
# ATS_BOARDS=greenhouse:company-token,lever:company

# Slice 02 caps / ESCO occupation title expansion
# Keep query budget small with RapidAPI — each query can take up to JSEARCH_TIMEOUT_MS.
CAREER_SEARCH_QUERY_BUDGET=2
CAREER_ANALYSIS_BATCH_SIZE=15
# Unique uncached extractions in parallel (request-bound; no durable worker).
CAREER_EXTRACTION_CONCURRENCY=2
# Max Groq calls per unique description (primary + one json_schema fallback).
CAREER_EXTRACTION_MAX_ATTEMPTS=2

# ESCO official occupation API (title alternatives only; never chooses career direction)
ESCO_API_BASE_URL=https://ec.europa.eu/esco/api
ESCO_TIMEOUT_MS=10000
ESCO_LANGUAGE=en
ESCO_MAX_ALTERNATIVE_TITLES=2

# --- Proactive career campaign (Phase 0+) ---
# Vercel Cron Authorization: Bearer <CRON_SECRET>
# CRON_SECRET=generate-a-long-random-secret
# CAMPAIGN_ANALYSIS_BATCH_SIZE=10
# CAMPAIGN_MAX_RECOMMENDATIONS_PER_RUN=5
# CAMPAIGN_RECOMMENDATION_MIN_SCORE=55
# CAMPAIGN_FOLLOW_UP_DAYS=7
# CAMPAIGN_CRON_USER_BATCH_SIZE=10
# PUBLIC_APP_BASE_URL=https://your-app.vercel.app

# Fresh Job Watch (proactive two-speed discovery)
# Vercel Hobby cron is daily only. For ~15 minute LinkedIn checks, call
# /api/cron/campaign from an external scheduler with CRON_SECRET.
# FRESH_LINKEDIN_INTERVAL_MINUTES=15
# FRESH_LINKEDIN_RECENCY_SECONDS=3600
# FRESH_BROAD_INTERVAL_HOURS=12
# FRESH_MAX_CANONICAL_SEARCHES_PER_TICK=5
# FRESH_LINKEDIN_MAX_PAGES=1
# FRESH_LINKEDIN_MAX_RESULTS=10
# FRESH_MAX_DESCRIPTION_FETCHES_PER_TICK=8
# FRESH_MAX_GROQ_ANALYSES_PER_TICK=8
# FRESH_MAX_ANALYSES_PER_USER=3
# FRESH_PROVIDER_COOLDOWN_MINUTES=30
# FRESH_SCHEDULER_LEASE_SECONDS=120
# FRESH_INITIAL_ALERT_CAP=3
# LINKEDIN_FRESH_ENABLED=true

# WhatsApp Cloud API (optional; in-app notifications work without these)
# WHATSAPP_ENABLED=false
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_VERIFY_TOKEN=
# WHATSAPP_APP_SECRET=
# WHATSAPP_TEMPLATE_RECOMMENDATION=zeno_recommendation
# WHATSAPP_TEMPLATE_LANGUAGE=en
