DEMO_USER_ID=00000000-0000-4000-8000-000000000001
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_STORAGE_BUCKET=cv-sources
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=llama-3.3-70b-versatile

# Preferred: OpenWeb Ninja direct JSearch key
# Get it at https://app.openwebninja.com/api/jsearch
JSEARCH_API_KEY=your-openwebninja-jsearch-key
JSEARCH_BASE_URL=https://api.openwebninja.com/jsearch

# Optional RapidAPI alternative (instead of JSEARCH_API_KEY / JSEARCH_BASE_URL):
# RAPIDAPI_KEY=your-rapidapi-key
# JSEARCH_API_HOST=jsearch.p.rapidapi.com

JSEARCH_TIMEOUT_MS=20000
JSEARCH_MAX_REQUESTS=1
JSEARCH_MAX_PAGES=2
JSEARCH_PAGE_SIZE=10
